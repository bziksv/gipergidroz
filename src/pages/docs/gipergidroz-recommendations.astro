---
import LegalLayout from '../../layouts/LegalLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const title = 'Правила применения рекомендательных технологий — gipergidroz.su';
const description =
  'Правила применения рекомендательных технологий сайта gipergidroz.su. ООО «АЛЬМАМЕД».';
const bodyHtml = fs.readFileSync(
  path.join(process.cwd(), 'src/content/legal/recommendation.html'),
  'utf8',
);
---

<LegalLayout title={title} description={description}>
  <div set:html={bodyHtml} />
</LegalLayout>
