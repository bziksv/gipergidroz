---
import LegalLayout from '../../layouts/LegalLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const title = 'Политика использования cookie-файлов — gipergidroz.su';
const description = 'Политика использования cookie-файлов сайта gipergidroz.su. ООО «АЛЬМАМЕД».';
const bodyHtml = fs.readFileSync(
  path.join(process.cwd(), 'src/content/legal/cookie.html'),
  'utf8',
);
---

<LegalLayout title={title} description={description}>
  <div set:html={bodyHtml} />
</LegalLayout>
